{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zarr Vectors Convention",
  "description": "Schema for the Zarr Vectors convention (format 0.9.2): spatially chunked, multi-resolution N-dimensional vector data (point clouds, meshes, skeletons, streamlines, graphs) stored in Zarr v3. Validates one node's zarr.json: the store root group, a resolution-level group, or a Zarr Vectors array / family group.",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3,
      "description": "Zarr format version. Zarr Vectors requires Zarr v3."
    },
    "node_type": {
      "type": "string",
      "enum": ["array", "group"],
      "description": "Type of Zarr node"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          }
        }
      },
      "required": ["zarr_conventions"],
      "oneOf": [
        {
          "$ref": "#/$defs/rootAttributes"
        },
        {
          "$ref": "#/$defs/levelAttributes"
        },
        {
          "$ref": "#/$defs/arrayAttributes"
        }
      ]
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "attributes": { "required": ["zarr_vectors"] }
        }
      },
      "then": {
        "properties": { "node_type": { "const": "group" } }
      }
    },
    {
      "if": {
        "properties": {
          "attributes": { "required": ["zarr_vectors_level"] }
        }
      },
      "then": {
        "properties": { "node_type": { "const": "group" } }
      }
    }
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Zarr Vectors convention metadata object for use in the zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/Andrew-Keenlyside/zarr-vectors/refs/tags/v0.9.2/schema.json",
          "description": "URL to the JSON Schema definition for this convention"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/Andrew-Keenlyside/zarr-vectors/blob/v0.9.2/README.md",
          "description": "URL to the full specification document"
        },
        "uuid": {
          "type": "string",
          "const": "66268a61-7833-4995-bbcb-233bb417dae5",
          "description": "UUID that permanently identifies this convention"
        },
        "name": {
          "type": "string",
          "const": "zarr_vectors",
          "description": "Human-readable name of the convention; matches the root nesting key"
        },
        "description": {
          "type": "string",
          "const": "Spatially chunked, multi-resolution N-dimensional vector data (point clouds, meshes, skeletons, streamlines, graphs)",
          "description": "Brief description of the convention's purpose and usage"
        }
      },
      "anyOf": [
        {
          "required": ["schema_url"]
        },
        {
          "required": ["spec_url"]
        },
        {
          "required": ["uuid"]
        }
      ],
      "additionalProperties": false
    },

    "rootAttributes": {
      "type": "object",
      "description": "Attributes of the store root group",
      "properties": {
        "zarr_conventions": true,
        "zarr_vectors": {
          "$ref": "#/$defs/rootMetadata"
        },
        "multiscales": {
          "$ref": "#/$defs/ngffMultiscales"
        }
      },
      "required": ["zarr_vectors", "multiscales"],
      "not": {
        "anyOf": [
          { "required": ["zarr_vectors_level"] },
          { "required": ["zv_array"] }
        ]
      },
      "additionalProperties": true
    },
    "rootMetadata": {
      "type": "object",
      "description": "Root metadata (zarr_vectors). Unknown keys are allowed and SHOULD be ignored by readers.",
      "properties": {
        "zv_version": {
          "type": "string",
          "pattern": "^0\\.9\\.[0-9]+$",
          "description": "REQUIRED. Zarr Vectors format version, X.Y.Z"
        },
        "chunk_shape": {
          "$ref": "#/$defs/positiveFloatVector",
          "description": "REQUIRED. Level-0 chunk shape, one entry per space axis"
        },
        "bounds": {
          "type": "array",
          "description": "REQUIRED. Global [min_corner, max_corner]",
          "items": { "$ref": "#/$defs/numberVector" },
          "minItems": 2,
          "maxItems": 2
        },
        "geometry_types": {
          "type": "array",
          "description": "REQUIRED. Geometry types present. Values outside the canonical set are custom types.",
          "items": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "point_cloud",
                  "line",
                  "polyline",
                  "streamline",
                  "skeleton",
                  "graph",
                  "mesh"
                ]
              },
              { "minLength": 1 }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "crs": {
          "type": ["object", "null"],
          "description": "OME-Zarr RFC 4 / 5 coordinate reference system, or null"
        },
        "links_convention": {
          "type": "string",
          "enum": [
            "explicit",
            "implicit_sequential",
            "implicit_sequential_with_branches"
          ],
          "default": "implicit_sequential"
        },
        "object_index_convention": {
          "type": "string",
          "enum": ["standard", "identity"],
          "default": "standard"
        },
        "cross_chunk_strategy": {
          "type": "string",
          "enum": ["explicit_links", "boundary_deduplication", "both"],
          "default": "explicit_links"
        },
        "reduction_factor": {
          "type": "integer",
          "minimum": 2,
          "default": 8
        },
        "base_bin_shape": {
          "oneOf": [
            { "$ref": "#/$defs/positiveFloatVector" },
            { "type": "null" }
          ]
        },
        "cross_level_depth": {
          "type": "integer",
          "minimum": -1,
          "default": 1
        },
        "cross_level_storage": {
          "type": "string",
          "enum": ["none", "implicit", "explicit"],
          "default": "explicit"
        },
        "format_capabilities": {
          "type": "array",
          "description": "Capability tokens. Open set: readers MUST NOT assume an unrecognised token's feature is present.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": ["zv_version", "chunk_shape", "bounds", "geometry_types"],
      "additionalProperties": true
    },
    "ngffMultiscales": {
      "type": "array",
      "description": "OME-NGFF 0.4 multiscales block (bare-root form). Defined by OME-NGFF; only the parts Zarr Vectors relies on are checked here.",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "axes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "unit": { "type": "string" }
                },
                "required": ["name"]
              }
            },
            "datasets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "pattern": "^[0-9]+$" },
                  "coordinateTransformations": { "type": "array" }
                },
                "required": ["path", "coordinateTransformations"]
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "format": { "const": "zarr_vectors" }
              },
              "required": ["format"]
            }
          },
          "required": ["axes", "datasets", "metadata"]
        }
      ]
    },

    "levelAttributes": {
      "type": "object",
      "description": "Attributes of a resolution-level group (0/, 1/, ...)",
      "properties": {
        "zarr_conventions": true,
        "zarr_vectors_level": {
          "$ref": "#/$defs/levelMetadata"
        }
      },
      "required": ["zarr_vectors_level"],
      "not": {
        "anyOf": [{ "required": ["zarr_vectors"] }, { "required": ["zv_array"] }]
      },
      "additionalProperties": true
    },
    "levelMetadata": {
      "type": "object",
      "description": "Per-level metadata (zarr_vectors_level). Unknown keys are allowed and SHOULD be ignored by readers.",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "description": "REQUIRED. Level index, 0 = full resolution"
        },
        "vertex_count": { "type": "integer", "minimum": 0 },
        "arrays_present": {
          "type": "array",
          "items": {
            "enum": [
              "vertices",
              "vertex_fragments",
              "link_fragments",
              "links",
              "vertex_attributes",
              "fragment_attributes",
              "link_attributes",
              "object_index",
              "object_attributes",
              "groups",
              "group_attributes"
            ]
          },
          "uniqueItems": true
        },
        "fragments_tile": { "type": "boolean", "default": false },
        "chunk_shape": {
          "oneOf": [
            { "$ref": "#/$defs/positiveFloatVector" },
            { "type": "null" }
          ],
          "description": "Per-level override; each axis a positive integer multiple of root chunk_shape"
        },
        "object_sparsity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "coarsening_method": {
          "type": "string",
          "enum": ["per_object", "manual", "none"]
        },
        "parent_level": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "chunk_dims": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "chunk_attribute_name": { "type": ["string", "null"] },
        "chunk_attribute_values": { "type": ["array", "null"] },
        "preserves_object_ids": { "type": "boolean", "default": false },
        "inherited_num_objects": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "shared_fragments": { "type": "boolean", "default": false }
      },
      "required": ["level"],
      "not": {
        "anyOf": [
          { "required": ["bin_shape"] },
          { "required": ["bin_ratio"] },
          { "required": ["bounds"] }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": { "preserves_object_ids": { "const": true } },
            "required": ["preserves_object_ids"]
          },
          "then": {
            "properties": { "inherited_num_objects": { "type": "integer" } },
            "required": ["inherited_num_objects"]
          }
        }
      ],
      "additionalProperties": true
    },

    "arrayAttributes": {
      "type": "object",
      "description": "Attributes of a Zarr Vectors array or family group, keyed by the zv_array discriminator",
      "properties": {
        "zarr_conventions": true,
        "zv_array": {
          "type": "string",
          "enum": [
            "vertices",
            "vertex_fragments",
            "link_fragments",
            "links_family",
            "links",
            "attribute",
            "fragment_attribute",
            "link_attribute_family",
            "link_attribute",
            "object_index",
            "object_attribute",
            "groups",
            "groupings_attribute"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "type": "string", "minLength": 1 },
        "shape": { "type": "array", "items": { "type": "integer" } },
        "row_shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "maxItems": 1
        },
        "channel_names": { "type": "array", "items": { "type": "string" } },
        "channel_dtype": { "type": "string" },
        "compression_codec": { "type": "string" },
        "chunk_grid_origin": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 1
        },
        "nonempty_chunks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.-?[0-9]+)*$"
          },
          "uniqueItems": true
        },
        "level_delta": { "type": "integer" },
        "link_width": { "type": "integer", "minimum": 1 },
        "offsets": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "required": ["zv_array"],
      "not": {
        "anyOf": [
          { "required": ["zarr_vectors"] },
          { "required": ["zarr_vectors_level"] }
        ]
      },
      "allOf": [
        {
          "if": { "properties": { "zv_array": { "const": "vertices" } } },
          "then": {
            "properties": { "encoding": { "enum": ["raw", "draco"] } },
            "required": ["dtype", "encoding"]
          }
        },
        {
          "if": {
            "properties": {
              "zv_array": { "enum": ["vertex_fragments", "link_fragments"] }
            }
          },
          "then": {
            "properties": { "encoding": { "const": "fragment_index_v1" } },
            "required": ["encoding"]
          }
        },
        {
          "if": { "properties": { "zv_array": { "const": "links_family" } } },
          "then": {
            "properties": {
              "sid_ndim": { "type": "integer", "minimum": 1 },
              "directed": { "type": "boolean" },
              "store": { "enum": ["canonical", "duplicate"] },
              "num_links": { "type": "integer", "minimum": 0 },
              "num_physical_records": { "type": "integer", "minimum": 0 }
            },
            "required": [
              "level_delta",
              "link_width",
              "sid_ndim",
              "directed",
              "store"
            ]
          }
        },
        {
          "if": { "properties": { "zv_array": { "const": "links" } } },
          "then": {
            "properties": { "has_perm": { "type": "boolean" } },
            "required": [
              "dtype",
              "offsets",
              "has_perm",
              "link_width",
              "level_delta"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "zv_array": { "enum": ["attribute", "fragment_attribute"] }
            }
          },
          "then": { "required": ["name", "dtype", "row_shape"] }
        },
        {
          "if": {
            "properties": { "zv_array": { "const": "link_attribute_family" } }
          },
          "then": { "required": ["name", "level_delta"] }
        },
        {
          "if": { "properties": { "zv_array": { "const": "link_attribute" } } },
          "then": {
            "required": ["name", "dtype", "row_shape", "offsets", "level_delta"]
          }
        },
        {
          "if": { "properties": { "zv_array": { "const": "object_index" } } },
          "then": {
            "properties": {
              "num_objects": { "type": "integer", "minimum": 0 },
              "num_present": { "type": "integer", "minimum": 0 },
              "sid_ndim": { "type": "integer", "minimum": 1 },
              "layout": { "const": "vlen_manifests_v1" }
            },
            "required": ["num_objects", "num_present", "sid_ndim", "layout"]
          }
        },
        {
          "if": { "properties": { "zv_array": { "const": "object_attribute" } } },
          "then": {
            "properties": { "fill_sentinel_meaning": { "const": "absent" } },
            "required": ["name", "dtype"]
          }
        },
        {
          "if": { "properties": { "zv_array": { "const": "groups" } } },
          "then": {
            "properties": {
              "num_groups": { "type": "integer", "minimum": 0 },
              "group_ranges": {
                "type": "object",
                "patternProperties": {
                  "^[0-9]+$": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["num_groups"]
          }
        },
        {
          "if": {
            "properties": { "zv_array": { "const": "groupings_attribute" } }
          },
          "then": { "required": ["name", "dtype"] }
        }
      ],
      "additionalProperties": true
    },

    "numberVector": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 1
    },
    "positiveFloatVector": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "minItems": 1
    }
  }
}
